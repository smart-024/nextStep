---
import { Image } from 'astro:assets';
import purposeImage from '../../public/stock_1.jpg';
import RegionalMap from './RegionalMap.astro';

// Propuesta de contenido para la consultora ficticia; reemplazar por los textos definitivos.
const values = [
  {
    title: 'Las personas, primero.',
    description: 'Pensamos la tecnología desde quienes la usan. La escucha y las distintas perspectivas son el punto de partida de cada idea.',
  },
  {
    title: 'La confianza se construye.',
    description: 'Creemos en las conversaciones claras, las decisiones compartidas y una mirada responsable sobre el impacto de la tecnología.',
  },
  {
    title: 'La curiosidad nos mueve.',
    description: 'Hacemos preguntas, exploramos posibilidades y seguimos aprendiendo para encontrar nuevas respuestas a los desafíos de siempre.',
  },
];
---

<section id="nosotros" aria-labelledby="nosotros-titulo" class="bg-brand-cream px-6 py-20 text-brand-primary md:py-28">
  <div class="mx-auto max-w-7xl">
    <p class="mb-8 text-xs font-bold uppercase tracking-[0.25em]">Quiénes somos</p>
    <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end lg:gap-16">
      <h2 id="nosotros-titulo" class="max-w-4xl text-4xl font-bold leading-[1.08] tracking-tight md:text-6xl">
        La tecnología es el medio.<br />El progreso es nuestro objetivo.
      </h2>
      <div class="space-y-5 text-lg leading-relaxed text-brand-primary/80">
        <p>En NextStep acompañamos a las organizaciones en su evolución tecnológica, combinando visión estratégica, creatividad y soluciones digitales.</p>
        <p>Nos interesa lo que viene, pero empezamos por lo que importa hoy: entender a las personas, sus desafíos y las oportunidades que tienen por delante.</p>
      </div>
    </div>

    <div class="purpose-card relative isolate mt-14 flex min-h-[36rem] flex-col items-start justify-between gap-20 overflow-hidden bg-brand-primary p-8 text-brand-cream md:min-h-[40rem] md:p-12 lg:mt-20">
      <Image
        src={purposeImage}
        alt=""
        width={1920}
        height={2880}
        widths={[640, 960, 1440, 1920]}
        sizes="(max-width: 1328px) calc(100vw - 48px), 1280px"
        format="webp"
        quality={80}
        loading="lazy"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-[center_42%]"
      />
      <div aria-hidden="true" class="purpose-shade pointer-events-none absolute inset-0 -z-10"></div>
      <div class="purpose-title max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.2em]">Nuestro propósito</p>
        <h3 class="mt-6 text-3xl font-bold leading-tight tracking-tight md:text-5xl">Hacer que el cambio abra nuevas posibilidades.</h3>
      </div>
      <div class="purpose-details max-w-xl">
        <p class="text-lg leading-relaxed">Imaginamos un futuro en el que la tecnología ayude a trabajar mejor, conectar ideas y crear oportunidades. Queremos acompañar ese camino con una mirada cercana y práctica.</p>
        <a href="#servicios" class="mt-8 inline-block border-b border-brand-cream pb-2 font-semibold transition-colors hover:text-brand-cream/80">Conocé nuestros servicios</a>
      </div>
    </div>

    <div class="mt-16 md:mt-20">
      <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em]">Lo que nos guía</p>
      <h3 class="max-w-2xl text-3xl font-bold tracking-tight md:text-4xl">Nuestra forma de ver el futuro.</h3>
      <div class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
        {values.map((value) => (
          <article class="border-t border-brand-primary/30 pt-6">
            <h4 class="text-2xl font-bold leading-tight">{value.title}</h4>
            <p class="mt-4 leading-relaxed text-brand-primary/80">{value.description}</p>
          </article>
        ))}
      </div>
    </div>

    <section aria-labelledby="region-titulo" class="mt-16 grid gap-10 border-t border-brand-primary/25 pt-12 md:mt-20 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em]">Cobertura regional</p>
        <h3 id="region-titulo" class="max-w-xl text-3xl font-bold tracking-tight md:text-4xl">Una región. Muchas posibilidades.</h3>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-brand-primary/80">Pensamos en Sudamérica como un espacio para conectar talento, ideas y desafíos. Nuestra propuesta combina una mirada regional con atención al contexto de cada organización.</p>
        <div class="mt-8 border-t border-brand-primary/25 pt-6" role="status" aria-live="polite" aria-atomic="true">
          <p id="regional-country-detail" class="text-2xl font-bold"></p>
          <p id="regional-country-description" class="mt-4 max-w-xl leading-relaxed text-brand-primary/80"></p>
        </div>
      </div>
      <RegionalMap />
    </section>
  </div>
</section>

<style>
  .purpose-title {
    transform-origin: top left;
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .purpose-details {
    transition: transform 550ms cubic-bezier(0.22, 1, 0.36, 1), opacity 400ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .purpose-details {
      opacity: 0;
      transform: translateY(calc(100% + 3rem));
      pointer-events: none;
    }

    .purpose-card:hover .purpose-title,
    .purpose-card:focus-within .purpose-title {
      transform: scale(1.08);
    }

    .purpose-card:hover .purpose-details,
    .purpose-card:focus-within .purpose-details {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .purpose-title,
    .purpose-details { transition: none; }

    .purpose-card:hover .purpose-title,
    .purpose-card:focus-within .purpose-title { transform: none; }
  }

  .purpose-shade {
    opacity: 0.85;
    transition: opacity 450ms ease;
    background: linear-gradient(
      180deg,
      var(--color-brand-primary) 0%,
      transparent 65%,
      var(--color-brand-primary) 100%
    );
    background-color: color-mix(in srgb, var(--color-brand-primary) 25%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    .purpose-shade { opacity: 0.55; }

    .purpose-card:hover .purpose-shade,
    .purpose-card:focus-within .purpose-shade { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .purpose-shade { transition: none; }
  }
</style>
