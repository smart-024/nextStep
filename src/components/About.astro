---
// Propuesta de contenido para la consultora ficticia; reemplazar por los textos definitivos.
const values = [
  {
    title: 'Las personas, primero.',
    description: 'Cada organización es diferente. Escuchamos a quienes forman parte de ella, comprendemos sus necesidades y consideramos sus perspectivas antes de proponer cambios.',
  },
  {
    title: 'La confianza se construye.',
    description: 'Promovemos relaciones transparentes, decisiones fundamentadas y un trabajo colaborativo orientado a construir soluciones sostenibles.',
  },
  {
    title: 'La curiosidad nos mueve.',
    description: 'Cuestionamos lo establecido, exploramos nuevas posibilidades y buscamos oportunidades para mejorar la manera en que las organizaciones trabajan y evolucionan.',
  },
];
---

<section id="nosotros" aria-labelledby="nosotros-titulo" class="bg-brand-cream px-6 py-20 text-brand-primary md:py-28">
  <div class="mx-auto max-w-7xl">
    <div class="about-intro grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end lg:gap-16">
      <h2 id="nosotros-titulo" class="max-w-4xl text-4xl font-bold leading-[1.08] tracking-tight md:text-6xl">
        La tecnología es el medio.<br /><span class="text-accent">El progreso es nuestro objetivo.</span>
      </h2>
      <p class="mx-auto mt-8 max-w-3xl text-center text-lg leading-relaxed text-brand-primary/80 md:mt-10 md:text-xl">
        Creemos que la transformación comienza por comprender a las organizaciones, sus necesidades y las personas que las integran. La tecnología genera valor cuando responde a objetivos concretos y contribuye a mejorar la manera en que trabajan.
      </p>
    </div>



    <div class="mt-16 md:mt-20">
      <div class="grid gap-8 md:grid-cols-3 md:gap-10">
        {values.map((value) => (
          <article class="border-t border-brand-primary/30 pt-6">
            <h4 class="text-2xl font-bold leading-tight">{value.title}</h4>
            <p class="mt-4 leading-relaxed text-brand-primary/80">{value.description}</p>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>
