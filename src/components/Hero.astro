---
interface Props {
  id?: string;
}

const { id = 'inicio' } = Astro.props;
---

<section
  id={id}
  class="hero-section relative isolate overflow-hidden bg-brand-primary text-brand-cream"
>
  <!-- Main content -->
  <div
    class="hero-content relative mx-auto flex w-full max-w-7xl flex-col justify-center px-6 py-24 lg:px-10"
  >
    <img
      src="/brand/nextstep-logo-oscuro.webp"
      width="520"
      height="447"
      alt="NextStep, consultoría en tecnología"
      class="hero-reveal mb-10 h-24 w-auto self-start md:h-32"
      decoding="async"
    />
    <h1
      class="max-w-6xl text-[clamp(2.5rem,8.5vw,8rem)] leading-[1.02]"
    >
      <slot name="title">
        <span class="sr-only">Adelantarse al futuro.</span>
        <span class="hero-type-line" aria-hidden="true">
          <span class="hero-type-text">Adelantarse</span>
        </span>
        <span class="hero-type-line" aria-hidden="true">
          <span class="hero-type-text">al <span class="text-accent">futuro</span>.</span>
        </span>
      </slot>
    </h1>

    <p
      class="hero-reveal hero-delay-2 mt-10 max-w-xl text-lg leading-relaxed text-brand-cream/80 md:text-xl"
    >
      <slot name="description">
        Acompañamos a las organizaciones en sus procesos de transformación,
        conectando estrategia, personas y tecnología para convertir desafíos en oportunidades de mejora.
      </slot>
    </p>

    <div class="hero-reveal hero-delay-3 mt-12 flex flex-wrap items-center gap-8">
      <slot name="actions">
      <a
        href="#nosotros"
        class="inline-flex items-center gap-6 bg-brand-rose px-7 py-4 font-semibold text-brand-primary transition-all duration-300 hover:-translate-y-1 hover:bg-brand-cream"
      >
        Descubrí NextStep
        <span aria-hidden="true">↓</span>
      </a>
      </slot>
    </div>
  </div>

</section>
