---
interface Props {
  id?: string;
  eyebrow?: string;
}

const { id = 'inicio', eyebrow = 'Consultoría en tecnología' } = Astro.props;
---

<section
  id={id}
  class="relative isolate flex min-h-[calc(100svh-5rem)] flex-col overflow-hidden bg-brand-primary text-brand-cream"
>
  <!-- Decorative background -->
  <div aria-hidden="true" class="hero-glow pointer-events-none absolute -right-32 top-20 -z-10 h-[32rem] w-[32rem] rounded-full md:h-[48rem] md:w-[48rem]"></div>

  <div
    aria-hidden="true"
    class="hero-ring hero-ring-outer pointer-events-none absolute -right-32 top-10 -z-10 h-96 w-96 rounded-full border border-brand-rose/25 md:h-[600px] md:w-[600px]"
  ></div>

  <div
    aria-hidden="true"
    class="hero-ring hero-ring-inner pointer-events-none absolute -right-16 top-24 -z-10 h-72 w-72 rounded-full border border-brand-rose/15 md:h-[450px] md:w-[450px]"
  ></div>

  <!-- Main content -->
  <div
    class="relative mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-6 py-24 lg:px-10"
  >
    <div class="hero-reveal">
      <p
        class="mb-8 text-xs font-bold uppercase tracking-[0.3em] text-brand-rose sm:text-sm"
      >
        {eyebrow}
      </p>
    </div>

    <h1
      class="hero-reveal hero-delay-1 max-w-6xl text-[clamp(3.4rem,8.5vw,8rem)] font-extrabold leading-[0.98] tracking-[-0.055em]"
    >
      <slot name="title">
        El futuro no<br />
        se espera.<br />
        <span class="text-brand-rose">Se construye.</span>
      </slot>
    </h1>

    <p
      class="hero-reveal hero-delay-2 mt-10 max-w-xl text-lg leading-relaxed text-brand-cream/80 md:text-xl"
    >
      <slot name="description">
        Transformamos desafíos en oportunidades a través de la
        tecnología, la estrategia y la innovación.
      </slot>
    </p>

    <div class="hero-reveal hero-delay-3 mt-12 flex flex-wrap items-center gap-8">
      <slot name="actions">
      <a
        href="#nosotros"
        class="inline-flex items-center gap-6 bg-brand-rose px-7 py-4 font-semibold text-brand-primary transition-all duration-300 hover:-translate-y-1 hover:bg-brand-cream"
      >
        Descubrí NextStep
        <span aria-hidden="true">↓</span>
      </a>
      </slot>
    </div>
  </div>

  <!-- Bottom strip -->
  <div class="relative border-t border-brand-cream/15">
    <div
      class="mx-auto flex max-w-7xl flex-wrap justify-between gap-4 px-6 py-6 text-xs font-semibold uppercase tracking-[0.2em] text-brand-cream/60 lg:px-10"
    >
      <span>Estrategia</span>
      <span>Tecnología</span>
      <span>Innovación</span>
    </div>
  </div>
</section>

<style>
  .hero-ring-outer {
    animation: ring-drift 18s ease-in-out infinite alternate;
  }

  .hero-ring-inner {
    animation: ring-drift 23s ease-in-out -8s infinite alternate-reverse;
  }

  .hero-glow {
    background: radial-gradient(circle, var(--color-brand-rose) 0%, transparent 68%);
    opacity: 0.12;
    animation: glow-drift 20s ease-in-out -5s infinite alternate;
  }

  @keyframes ring-drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-36px, 40px, 0) scale(1.12);
    }
  }

  @keyframes glow-drift {
    from {
      transform: translate3d(0, 0, 0) scale(0.95);
    }
    to {
      transform: translate3d(-48px, 32px, 0) scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ring,
    .hero-glow {
      animation: none;
    }
  }
</style>
