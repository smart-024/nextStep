<!-- Inline styles and script keep the first paint consistent, before hydration. -->
<style is:inline>
  .home-loader {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 1.5rem;
    background: #6B2737;
    color: #EEE0CB;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    touch-action: none;
    transition: opacity 250ms ease, visibility 250ms;
  }
  html[data-home-loading] .home-loader {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }
  html[data-home-loading] body.homepage > :is(header, main, footer) { visibility: hidden; }
  html[data-home-loading] .hero-reveal { animation-play-state: paused; }
  html[data-home-loading] { scroll-behavior: auto; overflow-anchor: none; }
  .home-loader-name { font: 400 2rem Georgia, serif; letter-spacing: -0.04em; }
  .home-loader-track {
    height: 2px;
    overflow: hidden;
    background: rgb(238 224 203 / 20%);
  }
  .home-loader-track::after {
    display: block;
    width: 45%;
    height: 100%;
    background: currentColor;
    content: '';
    animation: loader-slide 1s ease-in-out infinite alternate;
  }
  @keyframes loader-slide { from { transform: translateX(-100%); } to { transform: translateX(225%); } }
  @media (prefers-reduced-motion: reduce) {
    .home-loader { transition: none; }
    .home-loader-track::after { animation: none; width: 100%; }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const startAtTop = root.hasAttribute('data-home-start-top');
    root.setAttribute('data-home-loading', '');
    document.body.setAttribute('aria-busy', 'true');
    let revealed = false;
    let finished = false;
    let fontsReady = false;
    let pageLoaded = document.readyState === 'complete';
    const viewport = window.visualViewport;
    const measureViewport = () => {
      // Use the visible area, not svh, which third-party iOS browsers can misreport.
      if (viewport && Math.abs(viewport.scale - 1) > 0.01) return '';
      const height = Math.round(viewport?.height || window.innerHeight);
      const header = document.querySelector('body > header');
      const nav = header?.querySelector('nav');
      const border = header ? parseFloat(getComputedStyle(header).borderBottomWidth) || 0 : 0;
      const navHeight = Math.round((nav?.getBoundingClientRect().height || 80) + border);
      root.style.setProperty('--home-visible-height', `${height}px`);
      root.style.setProperty('--home-nav-height', `${navHeight}px`);
      return `${height}:${navHeight}`;
    };
    const refreshViewport = () => {
      // Toolbar resizing must not move sections while the user is reading below.
      if (!finished || window.scrollY <= 1) measureViewport();
    };
    viewport?.addEventListener('resize', refreshViewport);
    window.addEventListener('resize', refreshViewport);
    window.addEventListener('scroll', refreshViewport, { passive: true });
    const finish = () => {
      finished = true;
      if (startAtTop) window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      root.removeAttribute('data-home-loading');
      document.body.removeAttribute('aria-busy');
    };
    const reveal = () => {
      if (revealed) return;
      revealed = true;
      window.clearTimeout(fallback);
      // Let iOS finish updating browser chrome and its visible viewport before centering.
      const started = performance.now();
      let stableSince = started;
      let lastMeasurement = '';
      const settle = (now) => {
        const measurement = measureViewport();
        if (measurement !== lastMeasurement) { stableSince = now; lastMeasurement = measurement; }
        if (now - stableSince >= 200 || now - started >= 1000) finish();
        else requestAnimationFrame(settle);
      };
      requestAnimationFrame(settle);
    };
    const revealWhenReady = () => { if (fontsReady && pageLoaded) reveal(); };
    const fallback = window.setTimeout(reveal, 2500);
    document.addEventListener('DOMContentLoaded', () => {
      measureViewport();
      const ready = () => { fontsReady = true; revealWhenReady(); };
      if (document.fonts) document.fonts.ready.then(ready, ready);
      else ready();
    }, { once: true });
    window.addEventListener('load', () => { pageLoaded = true; revealWhenReady(); }, { once: true });
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        revealed = true; finished = true;
        window.clearTimeout(fallback);
        refreshViewport();
        root.removeAttribute('data-home-loading');
        document.body.removeAttribute('aria-busy');
      }
    });
  })();
</script>

<div class="home-loader" role="status" aria-label="Cargando NextStep">
  <span class="home-loader-name" aria-hidden="true">NextStep</span>
  <span class="home-loader-track" aria-hidden="true"></span>
</div>
