
---
const isHome = Astro.url.pathname === '/';
const homeAnchor = (id: string) => `${isHome ? '' : '/'}#${id}`;
const links = [
  { label: 'Inicio', href: homeAnchor('inicio') },
  { label: 'Nosotros', href: homeAnchor('nosotros') },
  { label: 'Servicios', href: homeAnchor('servicios') },
  { label: 'Contacto', href: isHome ? '#contacto' : '/contacto' },
];
---

<header
  class="sticky top-0 z-50 border-b border-brand-cream/15 bg-brand-primary text-brand-cream"
>
  <nav
    class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-10"
    aria-label="Navegación principal"
  >
    <!-- Desktop navigation -->
    <div class="hidden items-center gap-10 md:flex">
      {links.filter((link) => link.label !== 'Contacto').map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium transition-colors duration-200 hover:text-brand-rose"
        >
          {link.label}
        </a>
      ))}
    </div>

    <a
      href={isHome ? '#contacto' : '/contacto'}
      aria-current={Astro.url.pathname.replace(/\/$/, '') === '/contacto' ? 'page' : undefined}
      class="hidden text-sm font-medium transition-colors duration-200 hover:text-brand-rose md:inline-flex"
    >
      Contacto
    </a>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="ml-auto flex h-11 w-11 items-center justify-center border border-brand-cream/30 md:hidden"
    >
      <span aria-hidden="true" class="text-2xl">☰</span>
    </button>
  </nav>

  <!-- Mobile navigation -->
  <div
    id="mobile-menu"
    class="hidden border-t border-brand-cream/15 bg-brand-primary px-6 py-6 md:hidden"
  >
    <div class="flex flex-col gap-5">
      {links.map((link) => (
        <a
          href={link.href}
          class="mobile-link text-lg font-medium transition-colors hover:text-brand-rose"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');

  function closeMenu() {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Abrir menú');
  }

  toggle?.addEventListener('click', () => {
    if (!menu) return;

    const isOpen = !menu.classList.contains('hidden');

    menu.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
  });

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
