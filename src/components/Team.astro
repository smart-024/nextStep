---
import fs from 'node:fs';
import path from 'node:path';
import { team } from '../data/team';

// At build time, use the photo in public/equipo/ when it exists; otherwise show the initials.
const photoFor = (slug: string) => ['jpg', 'jpeg', 'webp', 'png']
  .map((extension) => `/equipo/${slug}.${extension}`)
  .find((file) => fs.existsSync(path.join(process.cwd(), 'public', file)));

// First name and last surname: "Juan José Torres" -> "JT", "Esteban de Nardo" -> "EN".
const initials = (name: string) => {
  const words = name.split(' ').filter((word) => word.length > 2);
  return `${words[0][0]}${words[words.length - 1][0]}`;
};

const members = team.map((member) => ({ ...member, photo: photoFor(member.slug), initials: initials(member.name) }));
---

<section class="team-block mt-16 grid gap-12 md:mt-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)] lg:gap-16" aria-labelledby="equipo-titulo">
  <div class="team-intro">
    <img
      src="/brand/nextstep-logo.webp"
      width="520"
      height="447"
      alt="NextStep, consultoría en tecnología"
      class="h-auto w-44 md:w-56"
      loading="lazy"
      decoding="async"
    />
    <h3 id="equipo-titulo" class="mt-8 text-3xl leading-tight md:text-4xl">Quiénes somos</h3>
    <p class="mt-4 leading-relaxed text-brand-primary/80">
      NextStep es el Equipo 3: seis perfiles complementarios que combinan consultoría tecnológica, gestión ágil, análisis de producto, diseño de experiencia y liderazgo técnico.
    </p>
  </div>

  <ul class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 md:grid-cols-3" role="list">
    {members.map((member) => (
      <li class="team-member flex flex-col items-center text-center">
        <div class="team-photo flex h-28 w-28 items-center justify-center overflow-hidden rounded-full bg-brand-primary text-brand-cream md:h-32 md:w-32">
          {member.photo
            ? <img src={member.photo} alt={`Foto de ${member.name}`} width="256" height="256" class="h-full w-full object-cover" loading="lazy" decoding="async" />
            : <span class="font-display text-3xl" aria-hidden="true">{member.initials}</span>}
        </div>
        <h4 class="mt-5 text-xl font-bold leading-tight">{member.name}</h4>
        <p class="team-role mt-1 font-interface text-xs uppercase tracking-[0.12em] text-brand-primary/70">{member.role}</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-brand-primary/75">{member.description}</p>
      </li>
    ))}
  </ul>
</section>
