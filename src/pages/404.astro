---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="No encontramos esta página. Volvé al inicio de NextStep o ponete en contacto con nosotros." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/typography.css" />
    <link rel="stylesheet" href="/page-theme.css" />
    <title>Página no encontrada | NextStep</title>
  </head>
  <body class="styled-page bg-brand-cream text-brand-primary antialiased">
    <Navbar />
    <main class="flex flex-1 items-center px-6 py-16 md:py-24">
      <div class="mx-auto w-full max-w-5xl">
        <div>
          <h1 class="max-w-2xl text-4xl font-normal leading-tight tracking-tight sm:text-5xl md:text-6xl">Página no encontrada</h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-brand-primary/80">La página que buscás no existe o cambió de dirección.</p>
          <div class="mt-10 flex flex-wrap items-center gap-6">
            <a href="/" class="page-submit inline-flex px-7 py-4 font-semibold">Volver a página principal</a>
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
