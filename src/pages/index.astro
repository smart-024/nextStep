
---
import '../styles/global.css';
import '../styles/home.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import HomeLoader from '../components/HomeLoader.astro';


---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Fraunces/static/Fraunces_72pt-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/saans-font-family/Saans-TRIAL-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="stylesheet" href="/typography.css" />
    <meta
      name="description"
      content="NextStep: consultoría en tecnología y transformación digital."
    />
    <title>NextStep | Consultoría en Tecnología</title>
  </head>

  <body class="homepage bg-brand-cream text-brand-primary antialiased">
    <HomeLoader />

    <!-- Navigation component -->
    <Navbar />

    <main>
      <!-- Hero component -->
      <Hero />

      <!-- About -->
      <About />

      <!-- Services -->
      <Services />

    </main>

    <!-- Footer -->
    <Footer />

  </body>
</html>
